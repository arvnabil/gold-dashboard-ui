APP_NAME="XAUUSD AI Hybrid Analyst"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=xau_analyst
DB_USERNAME=xau_user
DB_PASSWORD=secret_change_me

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=xau_cache_

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=redis_change_me
REDIS_PORT=6379

REVERB_APP_ID=xau-analyst-app
REVERB_APP_KEY=xau-reverb-key
REVERB_APP_SECRET=xau-reverb-secret
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME="http"

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Python Analysis Engine
ENGINE_INTERNAL_URL=http://127.0.0.1:8000
ENGINE_INTERNAL_TOKEN=engine_dev_token

# Collector Scoped Tokens
COLLECTOR_INGEST_TOKEN=collector_dev_secret_token

# Feature Flags
FEATURE_AI_ANALYSIS=false
FEATURE_TELEGRAM_NOTIFICATIONS=false
FEATURE_PAPER_TRADING=false

